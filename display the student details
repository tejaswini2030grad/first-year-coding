    scanf("%s",s1.name);
    printf("Roll number: ");
    scanf("%d",&s1.rollNumber);
    printf("Age: ");
    scanf("%d",&s1.age);
    printf("Enter student 2 name: ");
    scanf("%s",s2.name);
    printf("Roll number: ");
    scanf("%d",&s2.rollNumber);
    printf("Age: ");
    scanf("%d",&s2.age);
}
