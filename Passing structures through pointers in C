#include <stdio.h>

struct student {
    char name[50];
    int roll_no;
    float marks;
};

void display(struct student *ptr) {
    printf("Student Details:\n");
    printf("Name: %s\n", ptr->name);
    printf("Roll Number: %d\n", ptr->roll_no);
    printf("Marks: %.2f\n", ptr->marks);
}

int main() {
    struct student s;

    printf("Name: ");
    scanf("%s", s.name);

    printf("Roll number: ");
    scanf("%d", &s.roll_no);

    printf("Marks: ");
    scanf("%f", &s.marks);

    display(&s);

    return 0;
}