#include <stdio.h>

int isEven(int num) 
{
    return num % 2 == 0;
}

int isOdd(int num) 
{
    return num % 2 != 0;
}

int sumUsingPointers(int *arr, int n, int (*check)(int)) {
    int sum = 0;
    for(int i = 0; i < n; i++) 
    {
        if(check(*(arr + i))) 
        {
            sum = sum + *(arr + i);
        }
    }
    return sum;
}

int main() {
    int n;
    scanf("%d", &n);
    
    int arr[n];
    for (int i = 0; i < n; i++) {
        scanf("%d", &arr[i]);
    }
    
    int evenSum = sumUsingPointers(arr, n, isEven);
    int oddSum = sumUsingPointers(arr, n, isOdd);
    
    printf("%d\n", evenSum);
    printf("%d\n", oddSum);
    return 0;
}