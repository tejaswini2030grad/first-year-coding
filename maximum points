#include <stdio.h>
#include <stdlib.h>
int compare(const void *a, const void *b) {
    return (*(int*)b - *(int*)a); 
}
int main() {
    // //declare a variable
    int n, k;
    
    printf("No of events: ");
    scanf("%d", &n);
    int arr[n];
    printf("Activity points: ");
    for(int i = 0; i < n; i++) {
        scanf("%d", (arr + i));
    }
    printf("Maximum no of events (k): ");
    scanf("%d", &k);
    for(int i = 0; i < n - 1; i++) {
        for(int j = 0; j < n - i - 1; j++) {
            if(*(arr + j) < *(arr + j + 1)) {
                int temp = *(arr + j);
                *(arr + j) = *(arr + j + 1);
                *(arr + j + 1) = temp;
            }
        }
    }
    int max_points = 0;
    for(int i = 0; i < k && i < n; i++) {
        max_points += *(arr + i);
    }
    
    printf("Maximum activity points: %d\n", max_points);
    return 0;