#include <stdio.h>
void reverseArray(int arr[], int N) 
{
    for (int i = 0; i < N / 2; i++) 
    {
        int temp = arr[i];
        arr[i] = arr[N - 1 - i];
        arr[N - 1 - i] = temp;
    }
}
void printRoundedFloats(int arr[], int N) 
{
    for (int i = 0; i < N; i++) 
    {
        printf("%.2f ", (float)*(arr + i));
    }
    printf("\n");
}
int main() {
    int N;
    scanf("%d", &N);
    int arr[N];
    for (int i = 0; i < N; i++) {
        scanf("%d", &arr[i]);
    }
    reverseArray(arr, N);
    printRoundedFloats(arr, N);
    return 0;
}