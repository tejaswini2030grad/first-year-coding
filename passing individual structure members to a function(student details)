#include <stdio.h>

struct Student {
    char name[100];
    int rollNumber;
    float marks;
};

void displayDetails(char name[], int rollNumber, float marks) {
    printf("\n--- Student Details ---\n");
    printf("Name: %s\n", name);
    printf("Roll Number: %d\n", rollNumber);
    printf("Marks: %.2f\n", marks);
}

int main() {
    struct Student s;

    printf("Enter Student Name: ");
    scanf("%s", s.name);

    printf("Enter Roll Number: ");
    scanf("%d", &s.rollNumber);

    printf("Enter Marks: ");
    scanf("%f", &s.marks);

    displayDetails(s.name, s.rollNumber, s.marks);

    return 0;
}