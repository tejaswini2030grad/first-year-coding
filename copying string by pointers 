#include <stdio.h>
void copystr(char *str1,char *str2)
{
    while(*str1!='\0')
        {
            *str2=*str1;
            str1++;
            str2++;
        }
    *str2='\0';
}
int main()
{
    char str1[100],str2[100];
    printf("Enter str1: ");
    scanf("%s",str1);
    copystr(str1,str2);
    printf("Enter copied string: %s",str2);
}