#include <stdio.h>
unsigned long long fact(int n){
    if(n==0 || n==1)
    {
        return 1;
    }
    else
    {
        return n*fact(n-1);
    }
}
unsigned long long ncr(int n,int r)
{
    if(r>n)
    {
        return 0;
    }
    else 
    {
        return fact(n)/(fact(r)*fact(n-r));
    }
}
int main()
{
    int n,r;
    printf("Enter n,r values");
    scanf ("%d%d",&n,&r);
    printf("%d",ncr(n,r));
}