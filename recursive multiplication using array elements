#include <stdio.h>

int arrayProduct(int arr[], int N) {
    if(N <= 0) {
        return 1;
    }
    return arr[N - 1] * arrayProduct(arr, N - 1);
}
int main() {
    int N;
    scanf("%d", &N);
    int arr[N];
    for (int i = 0; i < N; i++) {
        scanf("%d", &arr[i]);
    }
    int product = arrayProduct(arr, N);
    printf("%d\n", product);
    return 0;
}