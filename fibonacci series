#include <stdio.h>
void fibonacci(int n,int t1,int t2)
{
    if(n<=0){
        return;
    }
    else{
        printf("%d",t1);
        int next;
        next=t1+t2;
        t1=t2;
        t2=next;
        fibonacci(n-1,t1,t2);
    }
}
int main()
{
    int n;
    printf("Enter n value");
    scanf("%d",&n);
    fibonacci(n,0,1);
    return 0;
}